{
  "name": "vite-basepath",
  "version": "1.0.0",
  "description": "Vite plugin that fixes asset paths so your app works in any subdirectory or domain path — zero config needed.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./runtime": {
      "import": "./src/runtime.js",
      "default": "./src/runtime.js"
    }
  },
  "bin": {
    "vite-basepath": "./bin/cli.js"
  },
  "files": [
    "src/",
    "bin/",
    "README.md"
  ],
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "lint": "eslint src/ bin/"
  },
  "keywords": [
    "vite",
    "plugin",
    "base",
    "base-path",
    "base-url",
    "subfolder",
    "subdirectory",
    "deploy",
    "path-fix",
    "dynamic",
    "relative",
    "assets",
    "build"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "vite": ">=3.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/vite-basepath"
  },
  "bugs": {
    "url": "https://github.com/your-username/vite-basepath/issues"
  },
  "homepage": "https://github.com/your-username/vite-basepath#readme"
}
